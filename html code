/* =====================================================
   CONFIRM ORDER
===================================================== */

function confirmOrder(){

    if(!selectedFood){

        toast(
            "Please select a meal."
        );

        return;
    }


    const address =
        document.getElementById(
            "deliveryAddress"
        ).value
        .trim();


    const phone =
        document.getElementById(
            "deliveryPhone"
        ).value
        .trim();


    if(!address){

        toast(
            "Please enter your delivery address."
        );

        return;
    }


    if(!phone){

        toast(
            "Please enter your phone number."
        );

        return;
    }


    const cleanPhone =
        phone.replace(
            /\D/g,
            ""
        );


    if(
        cleanPhone.length !== 10
    ){

        toast(
            "Enter a valid 10-digit phone number."
        );

        return;
    }


    const order = {

        id:
            "HP-" +
            Math.floor(
                100000 +
                Math.random() *
                900000
            ),

        customerId:
            currentUser.id,

        customerName:
            currentUser.name,

        customerEmail:
            currentUser.email,

        phone:
            cleanPhone,

        address:
            address,

        providerId:
            selectedFood.providerId,

        providerName:
            selectedFood.providerName,

        foodName:
            selectedFood.name,

        foodImage:
            selectedFood.image ||
            "",

        total:
            selectedFood.price,

        status:
            "PENDING",

        created:
            new Date()
                .toLocaleString()

    };


    orders.push(
        order
    );


    saveDB();


    closeOrderModal();


    selectedFood =
        null;


    customerStats();

    renderCustomerOrders();


    toast(
        "🎉 Order placed successfully!"
    );

}


