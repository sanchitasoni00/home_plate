}


/* =====================================================
   TRACKER
===================================================== */

function track(
    label,
    index,
    current
){

    return `

        <div
            class="
                track-step
                ${index <= current
                    ? "active"
                    : ""
                }
            "
        >

            <div class="track-circle">

                ${
                    index <= current
                    ? "✓"
                    : index + 1
                }

            </div>

            <div class="track-label">
                ${label}
            </div>

        </div>

    `;

}


