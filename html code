        "foodModal"
    ).classList.add(
        "hidden"
    );

}


/* =====================================================
   ADD FOOD
===================================================== */

function addFood(){

    const name =
        document.getElementById(
            "foodName"
        ).value
        .trim();


    const description =
        document.getElementById(
            "foodDescription"
        ).value
        .trim();


    const price =
        Number(
            document.getElementById(
                "foodPrice"
            ).value
        );


    const category =
        document.getElementById(
            "foodCategory"
        ).value;


    const imageInput =
        document.getElementById(
            "foodImage"
        );


    const file =
        imageInput.files[0];


    if(
        !name ||
        !description ||
        !price
    ){

        toast(
            "Please fill all details."
        );

        return;
    }


    if(!file){

        toast(
            "Please select a meal image."
        );

        return;
    }


    if(
        !file.type.startsWith(
            "image/"
        )
    ){

        toast(
            "Please select a valid image."
        );

        return;
    }


    const reader =
        new FileReader();


    reader.onload =
        function(e){

            foods.push({

                id:
                    Date.now(),

                providerId:
                    currentUser.id,

                providerName:
                    currentUser.name,

                name:
                    name,

                description:
                    description,

                price:
                    price,

                category:
                    category,

                image:
                    e.target.result

            });


            saveDB();


            closeFoodModal();


            renderProviderFoods();

            renderCustomerFoods();

            providerStats();


            document.getElementById(
                "foodName"
            ).value = "";


            document.getElementById(
                "foodDescription"
            ).value = "";


            document.getElementById(
                "foodPrice"
            ).value = "";


            document.getElementById(
                "foodImage"
            ).value = "";


            document.getElementById(
                "foodImagePreview"
            ).style.display =
                "none";


            toast(
                "🍛 Meal added successfully!"
            );

        };


    reader.readAsDataURL(
        file
    );

}


/* =====================================================
   CUSTOMER STATS
===================================================== */

function customerStats(){

    if(!currentUser){

        return;
    }


    const mine =
        orders.filter(
            order =>
                order.customerId ===
                currentUser.id
        );


    const active =
        mine.filter(
            order =>
                ![
                    "DELIVERED",
                    "REJECTED"
                ].includes(
                    order.status
                )
        );


    document.getElementById(
        "cTotal"
    ).innerText =
        mine.length;


    document.getElementById(
        "cActive"
    ).innerText =
        active.length;


    document.getElementById(
        "cMeals"
    ).innerText =
        foods.length;

}


/* =====================================================
   PROVIDER STATS
===================================================== */

function providerStats(){

    if(!currentUser){

        return;
    }


    const mine =
        orders.filter(
            order =>
                order.providerId ===
                currentUser.id
        );


    const pending =
        mine.filter(
            order =>
                order.status ===
                "PENDING"
        );


    const delivered =
        mine.filter(
            order =>
                order.status ===
                "DELIVERED"
        );


    const earnings =
        delivered.reduce(
            (
                total,
                order
            ) =>
                total +
                Number(
                    order.total
                ),
            0
        );


    document.getElementById(
        "pTotal"
    ).innerText =
        mine.length;


    document.getElementById(
        "pPending"
    ).innerText =
        pending.length;


    document.getElementById(
        "pDelivered"
    ).innerText =
        delivered.length;


    document.getElementById(
        "pEarnings"
    ).innerText =
        earnings;

}


