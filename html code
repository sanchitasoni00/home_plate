<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>
    HOMEPLATES | Home Food. Local Plates.
</title>


<style>

/* =====================================================
   GLOBAL
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    font-family:
    Inter,
    Arial,
    Helvetica,
    sans-serif;

    background:#fffaf7;

    color:#171717;

    overflow-x:hidden;
}

button,
input,
textarea,
select{
    font-family:inherit;
}

button{
    cursor:pointer;
}

:root{

    --orange:#ff6b35;

    --orange-light:#ff8a5b;

    --cream:#fff7f1;

    --dark:#171717;

    --gray:#6b7280;

    --light-gray:#f5f5f5;

    --border:rgba(0,0,0,.08);

    --green:#22c55e;

}


/* =====================================================
   BACKGROUND ANIMATION
===================================================== */

.background-orb{

    position:fixed;

    width:420px;

    height:420px;

    border-radius:50%;

    filter:blur(90px);

    opacity:.18;

    z-index:-10;

    pointer-events:none;

    animation:
        orbMove 12s
        ease-in-out
        infinite
        alternate;
}

.orb1{

    background:#ff6b35;

    top:-180px;

    left:-150px;
}

.orb2{

    background:#ffc4a8;

    right:-180px;

    bottom:50px;

    animation-delay:2s;
}

@keyframes orbMove{

    0%{
        transform:
        translate(0,0)
        scale(1);
    }

    50%{
        transform:
        translate(100px,70px)
        scale(1.15);
    }

    100%{
        transform:
        translate(-40px,120px)
        scale(.9);
    }

}


/* =====================================================
   NAVBAR
===================================================== */

.navbar{

    position:fixed;

    top:15px;

    left:50%;

    transform:translateX(-50%);

    width:min(1150px,92%);

    height:68px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:0 22px;

    background:
        rgba(255,255,255,.82);

    backdrop-filter:
        blur(20px);

    border:
        1px solid
        rgba(255,255,255,.8);

    border-radius:20px;

    box-shadow:
        0 12px 40px
        rgba(0,0,0,.07);

    z-index:100;

    animation:
        navDrop .7s ease both;
}

@keyframes navDrop{

    from{

        opacity:0;

        transform:
        translate(-50%,-40px);
    }

    to{

        opacity:1;

        transform:
        translate(-50%,0);
    }

}

.logo{

    font-size:23px;

    font-weight:900;

    letter-spacing:-1px;

    color:var(--orange);
}

.logo span{
    color:#171717;
}

.nav-links{

    display:flex;

    align-items:center;

    gap:8px;
}

.nav-btn{

    border:none;

    background:transparent;

    padding:10px 16px;

    border-radius:10px;

    font-weight:700;

    transition:.3s;
}

.nav-btn:hover{

    background:#fff0e9;

    transform:
    translateY(-2px);
}

.nav-btn.primary{

    background:var(--orange);

    color:white;

    box-shadow:
    0 8px 20px
    rgba(255,107,53,.25);
}

.nav-btn.primary:hover{

    background:#e95724;

    transform:
    translateY(-3px);
}


/* =====================================================
   HERO
===================================================== */

.hero{

    min-height:100vh;

    display:flex;

    align-items:center;

    padding:
        130px 5%
        80px;

    position:relative;
}

.hero-content{

    width:min(1200px,100%);

    margin:auto;

    display:grid;

    grid-template-columns:
        1.05fr .95fr;

    align-items:center;

    gap:50px;
}

.hero-text{

    animation:
        heroLeft 1s .2s ease both;
}

@keyframes heroLeft{

    from{

        opacity:0;

        transform:
        translateX(-50px);
    }

    to{

        opacity:1;

        transform:
        translateX(0);
    }

}

.badge{

    display:inline-flex;

    align-items:center;

    gap:8px;

    padding:
        9px 15px;

    border-radius:50px;

    background:#fff0e8;

    color:#ed5a28;

    font-size:13px;

    font-weight:800;

    margin-bottom:22px;

    animation:
        badgePulse 2.5s
        infinite;
}

@keyframes badgePulse{

    0%,100%{

        box-shadow:
        0 0 0
        rgba(255,107,53,0);
    }

    50%{

        box-shadow:
        0 0 0 9px
        rgba(255,107,53,.08);
    }

}

.hero h1{

    font-size:
        clamp(48px,7vw,78px);

    line-height:.98;

    letter-spacing:-5px;

    max-width:780px;
}

.hero h1 span{

    color:var(--orange);

    display:inline-block;

    animation:
        textFloat 3s
        ease-in-out
        infinite;
}

@keyframes textFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-5px);
    }

}

.hero-description{

    color:var(--gray);

    font-size:18px;

    line-height:1.7;

    max-width:650px;

    margin-top:25px;
}

.hero-buttons{

    display:flex;

    gap:12px;

    flex-wrap:wrap;

    margin-top:30px;
}


/* =====================================================
   BUTTONS
===================================================== */

.btn{

    padding:
        14px 22px;

    border:none;

    border-radius:12px;

    font-weight:800;

    transition:.3s;

    position:relative;

    overflow:hidden;
}

.btn-primary{

    color:white;

    background:
        linear-gradient(
            135deg,
            var(--orange),
            var(--orange-light)
        );

    box-shadow:
        0 10px 25px
        rgba(255,107,53,.25);
}

.btn-primary:hover{

    transform:
        translateY(-4px)
        scale(1.02);

    box-shadow:
        0 15px 35px
        rgba(255,107,53,.35);
}

.btn-outline{

    background:white;

    border:
        1px solid
        var(--border);
}

.btn-outline:hover{

    transform:
        translateY(-4px);

    border-color:
        var(--orange);

    color:
        var(--orange);
}


/* =====================================================
   HERO FOOD
===================================================== */

.hero-visual{

    min-height:500px;

    position:relative;

    display:flex;

    align-items:center;

    justify-content:center;

    animation:
        heroRight 1s .4s ease both;
}

@keyframes heroRight{

    from{

        opacity:0;

        transform:
        translateX(50px);
    }

    to{

        opacity:1;

        transform:
        translateX(0);
    }

}

.plate{

    width:350px;

    height:350px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            white 55%,
            #ffe7d9 56%,
            #ffd2bf 62%,
            white 63%
        );

    box-shadow:
        0 35px 80px
        rgba(0,0,0,.12);

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:155px;

    animation:
        plateFloat 5s
        ease-in-out
        infinite;
}

@keyframes plateFloat{

    0%,100%{

        transform:
        translateY(0)
        rotate(-2deg);
    }

    50%{

        transform:
        translateY(-18px)
        rotate(2deg);
    }

}

.floating-food{

    position:absolute;

    width:65px;

    height:65px;

    border-radius:18px;

    background:
        rgba(255,255,255,.9);

    backdrop-filter:
        blur(10px);

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:32px;

    box-shadow:
        0 15px 35px
        rgba(0,0,0,.1);

    animation:
        floatFood 4s
        ease-in-out
        infinite;
}

@keyframes floatFood{

    0%,100%{
        transform:
        translateY(0)
        rotate(0);
    }

    50%{
        transform:
        translateY(-20px)
        rotate(8deg);
    }

}

.food1{

    top:60px;
    left:10px;
}

.food2{

    top:100px;
    right:0;

    animation-delay:1s;
}

.food3{

    bottom:70px;
    left:30px;

    animation-delay:1.5s;
}

.food4{

    bottom:30px;
    right:50px;

    animation-delay:.7s;
}


/* =====================================================
   TRUST
===================================================== */

.trust{

    padding:
        20px 5%;

    border-top:
        1px solid var(--border);

    border-bottom:
        1px solid var(--border);

    background:
        rgba(255,255,255,.6);
}

.trust-inner{

    width:min(1100px,100%);

    margin:auto;

    display:flex;

    justify-content:
        space-around;

    flex-wrap:wrap;

    gap:20px;
}

.trust-item{

    display:flex;

    align-items:center;

    gap:8px;

    color:#555;

    font-size:14px;

    font-weight:700;
}


/* =====================================================
   SECTIONS
===================================================== */

.section{

    padding:
        110px 5%;
}

.container{

    width:min(1150px,100%);

    margin:auto;
}

.section-heading{

    text-align:center;

    margin-bottom:55px;
}

.section-heading .small{

    color:var(--orange);

    font-weight:800;

    text-transform:uppercase;

    letter-spacing:2px;

    font-size:12px;
}

.section-heading h2{

    font-size:
        clamp(34px,5vw,52px);

    letter-spacing:-2px;

    margin-top:10px;
}

.section-heading p{

    color:var(--gray);

    margin-top:12px;

    font-size:17px;
}


/* =====================================================
   FEATURE CARDS
===================================================== */

.feature-grid{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:18px;
}

.feature-card{

    background:
        rgba(255,255,255,.75);

    border:
        1px solid
        rgba(255,255,255,.9);

    padding:28px;

    border-radius:22px;

    box-shadow:
        0 10px 40px
        rgba(0,0,0,.05);

    transition:
        transform .4s,
        box-shadow .4s;

    opacity:0;

    transform:
        translateY(40px);
}

.feature-card.visible{

    opacity:1;

    transform:
        translateY(0);
}

.feature-card:hover{

    transform:
        translateY(-10px)
        rotate(.5deg);

    box-shadow:
        0 25px 60px
        rgba(0,0,0,.1);
}

.feature-icon{

    width:60px;

    height:60px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:18px;

    background:#fff0e9;

    font-size:30px;

    margin-bottom:20px;
}

.feature-card h3{

    font-size:19px;

    margin-bottom:10px;
}

.feature-card p{

    color:var(--gray);

    line-height:1.6;

    font-size:14px;
}


/* =====================================================
   STEPS
===================================================== */

.steps{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:20px;
}

.step{

    text-align:center;

    padding:25px;

    opacity:0;

    transform:
        scale(.9);
}

.step.visible{

    opacity:1;

    transform:
        scale(1);

    transition:
        .7s
        cubic-bezier(.2,.8,.2,1);
}

.step-number{

    width:70px;

    height:70px;

    margin:auto;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:50%;

    background:
        linear-gradient(
            135deg,
            var(--orange),
            #ff9a76
        );

    color:white;

    font-size:23px;

    font-weight:900;

    box-shadow:
        0 15px 30px
        rgba(255,107,53,.25);

    margin-bottom:18px;
}

.step h3{

    margin-bottom:8px;
}

.step p{

    color:var(--gray);

    font-size:14px;

    line-height:1.5;
}


/* =====================================================
   CTA
===================================================== */

.cta{

    margin:
        40px auto
        100px;

    width:min(1100px,90%);

    padding:
        70px 40px;

    border-radius:35px;

    text-align:center;

    color:white;

    background:
        linear-gradient(
            135deg,
            #ff5d27,
            #ff8a5b
        );

    position:relative;

    overflow:hidden;

    box-shadow:
        0 30px 70px
        rgba(255,107,53,.25);
}

.cta h2{

    font-size:
        clamp(34px,5vw,52px);

    position:relative;
}

.cta p{

    margin:
        15px auto
        25px;

    max-width:550px;

    opacity:.9;

    line-height:1.6;

    position:relative;
}

.cta .btn{

    background:white;

    color:var(--orange);

    position:relative;
}


/* =====================================================
   FOOTER
===================================================== */

.footer{

    background:#161616;

    color:white;

    padding:
        45px 5%;

    text-align:center;
}

.footer p{

    color:#999;

    margin-top:10px;

    font-size:14px;
}


/* =====================================================
   MODAL
===================================================== */

.modal{

    position:fixed;

    inset:0;

    background:
        rgba(10,10,10,.65);

    backdrop-filter:
        blur(8px);

    display:flex;

    align-items:center;

    justify-content:center;

    z-index:500;

    animation:
        fadeIn .25s ease;

    padding:20px;
}

@keyframes fadeIn{

    from{
        opacity:0;
    }

    to{
        opacity:1;
    }

}

.modal-box{

    width:min(470px,100%);

    max-height:90vh;

    overflow-y:auto;

    background:white;

    padding:32px;

    border-radius:25px;

    position:relative;

    animation:
        modalPop .4s
        cubic-bezier(.2,.8,.2,1);
}

@keyframes modalPop{

    from{

        opacity:0;

        transform:
            scale(.85)
            translateY(30px);
    }

    to{

        opacity:1;

        transform:
            scale(1)
            translateY(0);
    }

}

.modal-close{

    position:absolute;

    top:15px;

    right:18px;

    border:none;

    background:#f4f4f4;

    width:35px;

    height:35px;

    border-radius:50%;

    font-size:22px;
}

.modal-box h2{

    font-size:26px;

    margin-bottom:7px;
}

.modal-subtitle{

    color:var(--gray);

    font-size:14px;

    margin-bottom:25px;
}

.form-group{

    margin-bottom:16px;
}

.form-group label{

    display:block;

    font-size:13px;

    font-weight:800;

    margin-bottom:7px;
}

.form-group input,
.form-group select,
.form-group textarea{

    width:100%;

    padding:13px;

    border-radius:10px;

    border:
        1px solid #ddd;

    outline:none;

    transition:.2s;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus{

    border-color:
        var(--orange);

    box-shadow:
        0 0 0 4px
        rgba(255,107,53,.1);
}

.form-submit{

    width:100%;

    border:none;

    padding:14px;

    background:
        var(--orange);

    color:white;

    border-radius:10px;

    font-weight:800;

    transition:.3s;
}

.form-submit:hover{

    background:#e95623;

    transform:
        translateY(-2px);
}

.switch-auth{

    text-align:center;

    margin-top:18px;

    color:#777;

    font-size:13px;
}

.switch-auth span{

    color:var(--orange);

    font-weight:800;

    cursor:pointer;
}

.hidden{
    display:none !important;
}


/* =====================================================
   IMAGE UPLOAD
===================================================== */

.image-upload-box{

    border:
        2px dashed
        #ddd;

    border-radius:15px;

    padding:18px;

    text-align:center;

    transition:.3s;

    background:#fafafa;
}

.image-upload-box:hover{

    border-color:
        var(--orange);

    background:
        #fff8f4;
}

.food-preview{

    width:100%;

    height:180px;

    object-fit:cover;

    border-radius:15px;

    margin-top:12px;

    border:
        1px solid #ddd;
}


/* =====================================================
   DASHBOARD
===================================================== */

.dashboard{

    min-height:100vh;

    background:#f8fafc;
}

.dashboard-nav{

    height:70px;

    background:white;

    border-bottom:
        1px solid var(--border);

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:
        0 5%;

    position:sticky;

    top:0;

    z-index:30;
}

.user-info{

    display:flex;

    align-items:center;

    gap:12px;
}

.avatar{

    width:40px;

    height:40px;

    border-radius:50%;

    background:#fff0e9;

    color:var(--orange);

    display:flex;

    align-items:center;

    justify-content:center;

    font-weight:900;
}

.logout{

    border:none;

    background:#191919;

    color:white;

    padding:
        9px 14px;

    border-radius:9px;
}


/* =====================================================
   DASHBOARD LAYOUT
===================================================== */

.dashboard-layout{

    width:min(1250px,92%);

    margin:
        30px auto;

    display:grid;

    grid-template-columns:
        220px 1fr;

    gap:25px;
}

.sidebar{

    background:white;

    border:
        1px solid var(--border);

    border-radius:18px;

    padding:12px;

    height:max-content;

    position:sticky;

    top:95px;
}

.sidebar-title{

    padding:13px;

    font-size:11px;

    color:#999;

    font-weight:900;

    letter-spacing:1px;
}

.sidebar-btn{

    width:100%;

    border:none;

    background:transparent;

    text-align:left;

    padding:13px;

    border-radius:10px;

    margin-bottom:4px;

    transition:.25s;

    font-weight:600;
}

.sidebar-btn:hover,
.sidebar-btn.active{

    background:#fff0e9;

    color:var(--orange);

    transform:
        translateX(3px);
}

.page-title{

    margin-bottom:25px;

    animation:
        pageIn .5s ease;
}

@keyframes pageIn{

    from{

        opacity:0;

        transform:
            translateY(15px);
    }

    to{

        opacity:1;

        transform:
            translateY(0);
    }

}

.page-title h1{

    font-size:30px;

    letter-spacing:-1px;
}

.page-title p{

    color:var(--gray);

    margin-top:5px;
}


/* =====================================================
   STATS
===================================================== */

.stats{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:15px;

    margin-bottom:25px;
}

.stat{

    background:white;

    border:
        1px solid var(--border);

    border-radius:16px;

    padding:22px;

    transition:.3s;
}

.stat:hover{

    transform:
        translateY(-5px);

    box-shadow:
        0 15px 35px
        rgba(0,0,0,.07);
}

.stat-label{

    color:#888;

    font-size:13px;
}

.stat-value{

    color:var(--orange);

    font-size:30px;

    font-weight:900;

    margin-top:5px;
}


/* =====================================================
   DASHBOARD CARD
===================================================== */

.d-card{

    background:white;

    border:
        1px solid var(--border);

    border-radius:18px;

    padding:24px;

    margin-bottom:20px;

    animation:
        cardIn .5s ease;
}

@keyframes cardIn{

    from{

        opacity:0;

        transform:
            translateY(15px);
    }

    to{

        opacity:1;

        transform:
            translateY(0);
    }

}

.d-card-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:15px;

    margin-bottom:20px;
}


/* =====================================================
   FOOD GRID
===================================================== */

.food-grid{

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:18px;
}

.food-card{

    background:white;

    border:
        1px solid var(--border);

    border-radius:18px;

    overflow:hidden;

    transition:.35s;

    animation:
        foodIn .5s ease both;
}

@keyframes foodIn{

    from{

        opacity:0;

        transform:
            translateY(20px)
            scale(.96);
    }

    to{

        opacity:1;

        transform:
            translateY(0)
            scale(1);
    }

}

.food-card:hover{

    transform:
        translateY(-8px);

    box-shadow:
        0 20px 50px
        rgba(0,0,0,.09);
}

.food-image{

    height:180px;

    background:
        linear-gradient(
            135deg,
            #fff0e8,
            #ffe2d2
        );

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:65px;

    overflow:hidden;
}

.food-image img{

    width:100%;

    height:100%;

    object-fit:cover;

    display:block;
}

.food-body{

    padding:18px;
}

.food-body h3{

    margin-bottom:6px;
}

.food-body p{

    color:var(--gray);

    font-size:13px;

    line-height:1.5;
}

.food-bottom{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;

    margin-top:14px;
}

.price{

    color:var(--orange);

    font-size:20px;

    font-weight:900;
}


/* =====================================================
   ORDER
===================================================== */

.order{

    padding:20px;

    border:
        1px solid var(--border);

    border-radius:15px;

    margin-bottom:15px;

    animation:
        orderIn .5s ease;
}

@keyframes orderIn{

    from{

        opacity:0;

        transform:
            translateX(-20px);
    }

    to{

        opacity:1;

        transform:
            translateX(0);
    }

}

.order-top{

    display:flex;

    justify-content:space-between;

    align-items:flex-start;

    gap:15px;
}

.order-title-area{

    display:flex;

    align-items:center;

    gap:12px;
}

.order-thumb{

    width:55px;

    height:55px;

    border-radius:12px;

    overflow:hidden;

    background:#fff0e9;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:25px;

    flex-shrink:0;
}

.order-thumb img{

    width:100%;

    height:100%;

    object-fit:cover;
}

.order-id{

    color:#999;

    font-size:12px;

    margin-top:4px;
}

.order-price{

    font-size:20px;

    font-weight:900;

    white-space:nowrap;
}

.status{

    display:inline-block;

    margin-top:12px;

    padding:
        7px 11px;

    background:#fff0e9;

    color:var(--orange);

    border-radius:30px;

    font-size:12px;

    font-weight:900;
}

.status.green{

    background:#dcfce7;

    color:#15803d;
}

.status.red{

    background:#fee2e2;

    color:#b91c1c;
}

.order-details{

    margin-top:15px;

    padding-top:15px;

    border-top:
        1px solid var(--border);

    color:#666;

    line-height:1.8;

    font-size:13px;
}

.address-box{

    margin-top:10px;

    padding:13px;

    background:#fafafa;

    border-radius:10px;

    border:
        1px solid #eee;
}

.order-actions{

    display:flex;

    gap:8px;

    flex-wrap:wrap;

    margin-top:15px;
}

.order-btn{

    border:none;

    padding:
        10px 14px;

    border-radius:8px;

    font-weight:800;

    transition:.2s;
}

.order-btn:hover{

    transform:
        translateY(-2px);
}

.accept{

    background:#dcfce7;

    color:#15803d;
}

.reject{

    background:#fee2e2;

    color:#b91c1c;
}

.next{

    background:var(--orange);

    color:white;
}


/* =====================================================
   TRACKER
===================================================== */

.tracker{

    display:flex;

    justify-content:space-between;

    margin-top:25px;

    position:relative;
}

.tracker:before{

    content:"";

    position:absolute;

    left:30px;

    right:30px;

    top:15px;

    height:3px;

    background:#eee;
}

.track-step{

    width:20%;

    text-align:center;

    position:relative;

    z-index:2;
}

.track-circle{

    width:31px;

    height:31px;

    margin:auto;

    border-radius:50%;

    background:#eee;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:12px;

    transition:.4s;
}

.track-step.active
.track-circle{

    background:
        var(--orange);

    color:white;

    box-shadow:
        0 5px 15px
        rgba(255,107,53,.25);
}

.track-label{

    font-size:10px;

    color:#999;

    margin-top:7px;
}


/* =====================================================
   TOAST
===================================================== */

.toast{

    position:fixed;

    bottom:25px;

    right:25px;

    padding:
        15px 20px;

    background:#171717;

    color:white;

    border-radius:12px;

    z-index:1000;

    transform:
        translateY(100px);

    opacity:0;

    transition:.4s;

    box-shadow:
        0 15px 40px
        rgba(0,0,0,.2);
}

.toast.show{

    transform:
        translateY(0);

    opacity:1;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:1000px){

    .hero-content{

        grid-template-columns:1fr;

